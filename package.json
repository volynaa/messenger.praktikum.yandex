{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "start": "vite build && node server.cjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx --config .eslintrc.json",
    "lint:fix": "eslint . --ext .ts,.tsx --fix --config .eslintrc.json",
    "lint:styles": "stylelint \"**/*.{css,scss,sass,pcss}\"",
    "lint:styles:fix": "stylelint \"**/*.{css,scss,sass,pcss}\" --fix"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "postcss": "^8.5.6",
    "postcss-scss": "^4.0.9",
    "postcss-syntax": "^0.36.2",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.4",
    "vite-plugin-handlebars": "^2.0.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "handlebars": "^4.7.8"
  }
}
