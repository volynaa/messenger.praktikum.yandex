{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "start": "vite build && node server.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx --config .eslintrc.json",
    "lint:fix": "eslint . --ext .ts,.tsx --fix --config .eslintrc.json",
    "lint:styles": "stylelint \"**/*.{css,scss,sass,pcss}\"",
    "lint:styles:fix": "stylelint \"**/*.{css,scss,sass,pcss}\" --fix",
    "test": "mocha",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.3.1",
    "@types/sinon-chai": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "chai": "^6.2.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "husky": "^9.1.7",
    "mocha": "^11.7.4",
    "postcss": "^8.5.6",
    "postcss-scss": "^4.0.9",
    "postcss-syntax": "^0.36.2",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.0.4",
    "vite-plugin-handlebars": "^2.0.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "handlebars": "^4.7.8",
    "jsdom": "^27.0.0",
    "path-to-regexp": "^6.2.0",
    "sinon": "^21.0.0",
    "sinon-chai": "^4.0.1"
  }
}
