.spinner {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: absolute;
    left: 33%;
    top: 20%;
}

.spinner-circle {
    border-radius: 50%;
    animation: spin 1s linear infinite;
    border-style: solid;
    border-bottom-color: transparent;
}

.spinner-small .spinner-circle {
    width: 20px;
    height: 20px;
    border-width: 2px;
}

.spinner-medium .spinner-circle {
    width: 40px;
    height: 40px;
    border-width: 3px;
}

.spinner-large .spinner-circle {
    width: 60px;
    height: 60px;
    border-width: 4px;
}

.spinner-primary .spinner-circle {
    border-color: #3369f3;
    border-bottom-color: transparent;
}

.spinner-secondary .spinner-circle {
    border-color: #999;
    border-bottom-color: transparent;
}

.spinner-white .spinner-circle {
    border-color: #fff;
    border-bottom-color: transparent;
}

.spinner-text {
    margin-top: 8px;
    font-size: 14px;
    color: #999;
    text-align: center;
}

.spinner-primary .spinner-text {
    color: #3369f3;
}

.spinner-secondary .spinner-text {
    color: #666;
}

.spinner-white .spinner-text {
    color: #fff;
}

@keyframes spin {
    0% {
        transform: rotate(0deg);
    }

    100% {
        transform: rotate(360deg);
    }
}

.spinner-hidden {
    display: none;
}

.spinner-centered {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
}

.spinner-dots {
    display: inline-flex;
    gap: 4px;
}

.spinner-dots .spinner-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    animation: bounce 1.4s infinite ease-in-out both;
}

.spinner-dots .spinner-dot:nth-child(1) {
    animation-delay: -0.32s;
}

.spinner-dots .spinner-dot:nth-child(2) {
    animation-delay: -0.16s;
}

@keyframes bounce {
    0%, 80%, 100% {
        transform: scale(0);
    }

    40% {
        transform: scale(1);
    }
}
