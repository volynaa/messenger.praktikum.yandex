.modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    transition: all 0.3s ease;
    background-color: rgba(0, 0, 0, 0.5);
    .button{
        width: 165px;
    }
}

.modal-content {
    background: white;
    border-radius: 8px;
    padding: 20px;
    max-width: 340px;
    width: 90%;
    max-height: 80vh;
    position: relative;
    transform: translateY(-20px);
}

.modal-header {
    margin-bottom: 15px;
    padding-bottom: 10px;
    border-bottom: 1px solid #eee;
    font-weight: 500;
    font-size: 15px;
    line-height: 20px;
    text-align: center;
}

.modal-header h3 {
    margin: 0;
    color: #333;
}

.modal-close {
    position: absolute;
    top: 10px;
    right: 10px;
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    padding: 0;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
}


.button-close{
  background-color: var(--bg-red);
}

