<div class="app">
    <div class="login-page">
        <div class="login-container register-container">
            <h2 class="mt-30 mb-40">Регистрация</h2>
            <div class="input-container">
                <label class="grey-text">Почта</label>
                {{> Input id="email" type="text" placeholder="Почта"}}
            </div>

            <div class="input-container">
                <label class="grey-text">Логин</label>
                {{> Input id="login" type="text" placeholder="Логин"}}
            </div>

            <div class="input-container">
                <label class="grey-text">Имя</label>
                {{> Input id="first_name" type="text" placeholder="Имя"}}
            </div>

            <div class="input-container">
                <label class="grey-text">Фамилия</label>
                {{> Input id="second_name" type="text" placeholder="Фамилия"}}
            </div>

            <div class="input-container">
                <label class="grey-text">Телефон</label>
                {{> Input id="phone" type="text" placeholder="Телефон"}}
            </div>

            <div class="input-container">
                <label class="grey-text">Пароль</label>
                {{> Input id="password" type="text" placeholder="Пароль"}}
            </div>

            <div class="input-container">
                <label class="grey-text">Пароль (еще раз)</label>
                {{> Input id="doublePassword" type="text" placeholder="Пароль (еще раз)"}}
            </div>

            <div class="button-container">
                <div>{{> Button id="register" text="Зарегистрироваться" dataPage="login"}}</div>
                <div>{{> Button id="log-in" text="Авторизация" dataPage="login"}}</div>
            </div>


        </div>
    </div>
</div>
