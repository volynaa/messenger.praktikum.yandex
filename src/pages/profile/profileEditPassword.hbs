<div class="app">
    <img id="back-edit" src="/arrow-right-blue.svg" class="button-back">
    <div class="profile-container">
        <div class="profile-photo">
            <img src="/photo.svg">
        </div>
        <div class="profile-edit">
            <div class="input-container flex-column">
                <label class="grey-text">Старый пароль</label>
                {{> Input id="old_password" type="text" placeholder="Старый пароль"}}
            </div>

            <div class="input-container flex-column">
                <label class="grey-text">Новый пароль</label>
                {{> Input id="new_password" type="text" placeholder="Новый пароль"}}
            </div>

            <div class="input-container flex-column">
                <label class="grey-text">Повторите новый пароль</label>
                {{> Input id="new_second_password" type="text" placeholder="Повторите новый пароль"}}
            </div>
        </div>
        <div class="mt-50">{{> Button id="save-edit" text="Сохранить" dataPage="profile"}}</div>
    </div>
</div>
