<div class="app">
    {{{Img
            id="back-edit"
            src="/arrow-right-blue.svg"
            className="button-back"
            alt="Вернуться назад"
            dataPage="profileIndex"
    }}}
    <main class="profile-container">
        <figure class="profile-photo">
            <img src="/photo.svg" alt="Аватар пользователя">
        </figure>
        <div class="profile-edit">
            <form class="input-container flex-column" id="input-container">
                <div class="flex-column">
                    <label class="grey-text">Старый пароль</label>
                    {{{ Input
                            id="old_password"
                            name="old_password"
                            type="text"
                            placeholder="Старый пароль"
                            minLen="8"
                            maxLen="40"
                            req=true
                            pat="^(?=.*[A-Z])(?=.*\d).+$"
                    }}}
                </div>

                <div class="flex-column">
                    <label class="grey-text">Новый пароль</label>
                    {{{ Input
                            id="new_password"
                            name="new_password"
                            type="text"
                            placeholder="Новый пароль"
                            minLen="8"
                            maxLen="40"
                            req=true
                            pat="^(?=.*[A-Z])(?=.*\d).+$"
                    }}}
                </div>

                <div class="flex-column">
                    <label class="grey-text">Повторите новый пароль</label>
                    {{{ Input
                            id="password-repeat"
                            name="password-repeat"
                            type="text"
                            placeholder="Повторите новый пароль"
                            minLen="8"
                            maxLen="40"
                            req=true
                            pat="^(?=.*[A-Z])(?=.*\d).+$"
                    }}}
                </div>

                {{{ Button
                        id="save-edit"
                        name="save-edit"
                        text="Сохранить"
                        dataPage="profileIndex"
                        classDiv="mt-50"
                        type="submit"
                }}}
            </form>
        </div>
    </main>
</div>
