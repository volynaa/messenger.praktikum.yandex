<div class="app">
    {{{Img
            id="back-edit"
            src="/arrow-right-blue.svg"
            className="button-back"
            alt="Вернуться назад"
            dataPage="/messenger"
    }}}
    <main class="profile-container">
        <figure class="profile-photo">
            <img src={{avatarUrl profile.avatar}} alt="Аватар пользователя">
        </figure>
        <h2 class="title">{{profile.first_name}}</h2>
        <div class="form-group">
            <span class="left-element">Почта</span>
            <span class="right-element">{{profile.email}}</span>
        </div>

        <div class="form-group">
            <span class="left-element">Логин</span>
            <span class="right-element">{{profile.login}}</span>
        </div>

        <div class="form-group">
            <span class="left-element">Имя</span>
            <span class="right-element">{{profile.first_name}}</span>
        </div>

        <div class="form-group">
            <span class="left-element">Фамилия</span>
            <span class="right-element">{{profile.second_name}}</span>
        </div>

        <div class="form-group">
            <span class="left-element">Имя в чате</span>
            <span class="right-element">{{profile.display_name}}</span>
        </div>

        <div class="form-group">
            <span class="left-element">Телефон</span>
            <span class="right-element">{{profile.phone}}</span>
        </div>

        {{{ Button
                id="editData"
                name="editData"
                className="color-blue"
                classDiv="form-group mt-50"
                text="Изменить данные"
                aria_label="Изменить данные"
                dataPage="/settings/data"
        }}}
        {{{ Button
                id="editPassword"
                name="editPassword"
                className="color-blue"
                classDiv="form-group"
                text="Изменить пароль"
                aria_label="Изменить пароль"
                dataPage="/settings/password"
        }}}
        {{{ Button
                className="color-red"
                classDiv="form-group"
                text="Выйти"
                aria_label="Выйти"
                dataPage="/"
        }}}
    </main>
</div>
