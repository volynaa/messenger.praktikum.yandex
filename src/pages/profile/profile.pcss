.button-back{
    cursor: pointer;
    transform: rotate(180deg);
    background: none;
    border: none;
}

.profile-container{
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    height: 90vh;

    .profile-photo{
        width: 130px;
        height: 130px;
        border-radius: 100px;
        background-color: var(--bg-grey);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        .profile-photo-load{
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 100px;
        }
    }

    .title{
        font-weight: 600;
        font-size: 16px;
        line-height: 16px;
        margin-bottom: 50px;
        margin-top: 20px;
    }
}

.profile-edit{
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-top: 30px;
}

.avatar-upload {
    position: relative;
    margin-top: 10px;
}

.avatar-input {
    display: none;
}

.avatar-label {
    display: flex;
    padding: 8px 16px;
    background: #3369F3;
    color: white;
    border-radius: 4px;
    cursor: pointer;
    height: 10px;
    font-size: 13px;
    line-height: 13px;
    align-items: center;
    justify-content: center;
}
