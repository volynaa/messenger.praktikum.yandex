<div class="app">
    {{{Img
            id="back-edit"
            src="/arrow-right-blue.svg"
            className="button-back"
            alt="Вернуться назад"
            dataPage="/settings"
    }}}
    <main class="profile-container">
        <figure class="profile-photo">
            <img src={{avatarUrl profile.avatar}} alt="Аватар пользователя" class="avatar-preview">
        </figure>
        <div class="avatar-upload">
            {{{ Input
                    id="avatar"
                    name="avatar"
                    type="file"
                    accept="image/*"
                    className="avatar-input"
            }}}
            <label for="avatar" class="avatar-label">Изменить аватар</label>
        </div>
        <div class="profile-edit">
            <form class="input-container flex-column" id="input-container">
                <div class="flex-column">
                    <label class="grey-text">Почта</label>
                    {{{ Input
                            id="email"
                            type="text"
                            value=profile.email
                            placeholder="Почта"
                            name="email"
                            req=true
                            pat="^[a-z0-9_-]+@[a-z]+\.[a-z]+$"
                    }}}
                </div>

                <div class="flex-column">
                    <label class="grey-text">Логин</label>
                    {{{ Input
                            id="login"
                            name="login"
                            type="text"
                            value=profile.login
                            placeholder="Логин"
                            minLen="3"
                            maxLen="20"
                            req=true
                            pat="^[a-zA-Zа-яА-Я0-9_-]+$"
                    }}}
                </div>

                <div class="flex-column">
                    <label class="grey-text">Имя</label>
                    {{{ Input
                            id="first_name"
                            name="first_name"
                            type="text"
                            value=profile.first_name
                            placeholder="Имя"
                            req=true
                            pat="^[A-ZА-ЯЁ][a-zа-яё-]*[a-zа-яё]+$"
                    }}}
                </div>

                <div class="flex-column">
                    <label class="grey-text">Фамилия</label>
                    {{{ Input
                            id="second_name"
                            name="second_name"
                            type="text"
                            value=profile.second_name
                            placeholder="Фамилия"
                            req=true
                            pat="^[A-ZА-ЯЁ][a-zа-яё-]*[a-zа-яё]+$"
                    }}}
                </div>

                <div class="flex-column">
                    <label class="grey-text">Имя в чате</label>
                    {{{ Input
                            id="display_name"
                            name="display_name"
                            type="text"
                            value=profile.display_name
                            placeholder="Имя в чате"
                    }}}
                </div>

                <div class="flex-column">
                    <label class="grey-text">Телефон</label>
                    {{{ Input
                            id="phone"
                            name="phone"
                            type="text"
                            value=profile.phone
                            placeholder="Почта"
                            minLen="10"
                            maxLen="15"
                            req=true
                            pat="^(\+\d+|\d+)$"
                    }}}
                </div>

                {{{ Button
                        id="save-edit"
                        name="save-edit"
                        classDiv="mt-50"
                        text="Сохранить"
                        dataPage="/settings"
                        type="submit"
                }}}
            </form>
        </div>
    </main>
</div>
