<div class="app">
    <main class="login-page">
        <div class="login-container">
            <h2 class="mt-30 mb-40">Вход</h2>
            <form class="input-container" id="login-form">
                <label for="login" class="grey-text">Логин</label>
                {{> Input
                        id="login"
                        type="text"
                        placeholder="Логин"
                        minLen="3"
                        maxLen="20"
                        pat="^[a-zA-Zа-яА-Я0-9_-]+$"
                }}

                <label for="password" class="grey-text">Пароль</label>
                {{> Input
                        id="password"
                        type="text"
                        placeholder="Пароль"
                        minLen="8"
                        maxLen="40"
                        pat="^(?=.*[A-Z])(?=.*[0-9])[a-zA-Z0-9]+$"
                }}

                <div class="button-container">
                    <div>{{> Button id="log-in" text="Авторизоваться" dataPage="chats" type="submit"}}</div>
                    <div>{{> Button id="register" text="Регистрация" dataPage="register" type="submit"}}</div>
                </div>
            </form>
        </div>
    </main>
</div>
