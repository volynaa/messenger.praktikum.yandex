<div class="app">
    <main class="login-page">
        <div class="login-container">
            <h2 class="mt-30 mb-40">Вход</h2>
            <form class="input-container">
                <label for="login" class="grey-text">Логин</label>
                {{> Input id="login" type="text" placeholder="Логин"}}
            </form>

            <form class="input-container">
                <label for="password" class="grey-text">Пароль</label>
                {{> Input id="password" type="text" placeholder="Пароль"}}
            </form>

            <div class="button-container">
                <div>{{> Button id="log-in" text="Авторизоваться" dataPage="chats"}}</div>
                <div>{{> Button id="register" text="Регистрация" dataPage="register"}}</div>
            </div>


        </div>
    </main>
</div>
