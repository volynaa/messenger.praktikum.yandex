<div class="app">
    <main class="login-page">
        <div class="login-container">
            <h2 class="mt-30 mb-40">Вход</h2>
            <form class="input-container" id="login-form">
                <label for="login" class="grey-text">Логин</label>
                {{{ Input
                        id="login"
                        name="login"
                        type="text"
                        placeholder="Логин"
                        minLen="3"
                        maxLen="20"
                        req=true
                        pat="^[a-zA-Z0-9_-]+$"
                }}}

                <label for="password" class="grey-text">Пароль</label>
                {{{ Input
                        id="password"
                        name="password"
                        type="text"
                        placeholder="Пароль"
                        minLen="8"
                        maxLen="40"
                        req=true
                        pat="^(?=.*[A-Z])(?=.*\d).+$"
                }}}

                <div class="button-container">
                    <div>{{{Button id="log-in" text="Авторизоваться" dataPage="chats" type="submit"}}}</div>
                    <div>{{{Button id="register" text="Регистрация" dataPage="register" type="button"}}}</div>
                </div>
            </form>
        </div>
    </main>
</div>
