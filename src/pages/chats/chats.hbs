<div class="app">
    <main class="chats-page">
        <aside class="chats-list">
            {{{ Button
                    id="profile"
                    name="profile"
                    withIcon=true
                    iconSrc="/arrow-right.svg"
                    className="button-profile"
                    classDiv="button-cont"
                    text="Профиль"
                    aria_label="Профиль"
                    dataPage="/settings"
            }}}
            <form role="search">
                {{{ Input
                        id="search"
                        name="search"
                        className="chat-search"
                        placeholder="Поиск"
                        aria-label="Поиск чатов"
                }}}
            </form>
            <section id="chat-container" aria-label="Список чатов">
                {{#if chats.length}}
                    {{# each chats}}
                        {{{Chat
                            id=id
                            avatar=avatar
                            name=name
                            lastMessage=lastMessage
                            time=time
                            countNewMessage=countNewMessage
                        }}}
                    {{/each}}
                {{/if}}
            </section>
        </aside>
        <section class="chat-message {{#if selected}}chat-message-selected{{/if}}">
            {{#if selected}}
                <header class="chat-message-header">
                    {{#if avatar.length}}
                        <img src="{{avatar}}" alt="Аватар пользователя">
                    {{else}}
                        <div class="chat-message-avatar"> </div>
                    {{/if}}
                    <h2 class="chat-name">{{selected.name}}</h2>
                    <img class="burger-menu" src="/burger-menu.svg" alt="Меню">
                </header>
                <section class="chat-message-body">
                    {{# each selected.message}}
                        {{#if type}}
                            <div class="chat-message-body-incoming">{{text}}
                                <img src="/sent.svg" alt="Доставлено">
                                <span class="chat-message-body-time">{{time}}</span>
                            </div>
                        {{else}}
                            <div class="chat-message-body-outgoing">{{text}}
                                <span class="chat-message-body-time">{{time}}</span>
                            </div>
                        {{/if}}
                    {{/each}}
                </section>
                <footer class="chat-message-footer">
                    <button type="button" aria-label="Прикрепить файл">
                        <img src="/clip.svg" alt="">
                    </button>
                    <form class="flex" id="message-form">
                        {{{ Input
                                id="message"
                                name="message"
                                type="text"
                                placeholder="Сообщение"
                                aria_label="Текст сообщения"
                                className="chat-message-footer-input"
                                req=true
                                errorShow=false
                        }}}
                        {{{ Img
                                id="sendMessage"
                                src="/arrow-right-blue.svg"
                                alt="Отправить сообщение"
                                className="button-send"
                        }}}

                    </form>
                </footer>
            {{else}}
                <label>Выберите чат чтобы отправить сообщение</label>
            {{/if}}
        </section>
    </main>
</div>
