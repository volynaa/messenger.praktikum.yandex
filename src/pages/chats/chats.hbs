<div class="app">
    <main class="chats-page">
        <aside class="chats-list">
            {{{ Button
                    id="profile"
                    name="profile"
                    withIcon=true
                    iconSrc="/arrow-right.svg"
                    className="button-profile"
                    classDiv="button-cont"
                    text="Профиль"
                    aria_label="Профиль"
                    dataPage="/settings"
            }}}
            {{{ Button
                    id="add-chat"
                    name="add-chat"
                    withIcon=true
                    className="button button-add-chat"
                    classDiv="mt-10"
                    text="Добавить чат"
                    aria_label="Добавить чат"
            }}}
            {{#if chats.length}}
                <form role="search">
                    {{{ Input
                            id="search"
                            name="search"
                            className="chat-search"
                            placeholder="Поиск"
                            aria-label="Поиск чатов"
                    }}}
                </form>
            {{/if}}
            {{#if (isEmpty chats)}}
                <div class="no-chats">Чаты не найдены</div>
            {{else if chats.length}}
                <section id="chat-container" aria-label="Список чатов" class="chat-container">
                    {{#each chats}}
                        {{{Chat
                                id=id
                                avatar=avatar
                                name=title
                                lastMessage=lastMessage
                                time=time
                                countNewMessage=countNewMessage
                        }}}
                    {{/each}}
                </section>
            {{else}}
                {{{Spinner
                        size="medium"
                        color="primary"
                        text="Загрузка чатов..."
                }}}
            {{/if}}

        </aside>
        <section class="chat-message {{#if selected}}chat-message-selected{{/if}}">
            {{#if selected}}
                <header class="chat-message-header">
                    {{#if avatar.length}}
                        <img src="{{avatar}}" alt="Аватар пользователя">
                    {{else}}
                        <div class="chat-message-avatar"> </div>
                    {{/if}}
                    <h2 class="chat-name">{{selected.title}}</h2>
                    <div id="burger-menu" class="burger-menu">
                        <img src="/chat/burger-menu.svg" alt="Меню">
                    </div>
                    <div class="menu" style="opacity: {{#if openMenu}}1{{else}}0{{/if}}">
                        {{{ Button
                                id="add-user"
                                name="add-user"
                                withIcon=true
                                iconSrc="/chat/plus.svg"
                                classDiv="menu-but-container"
                                iconClass="icon"
                                text="Добавить пользователя"
                                aria_label="Добавить пользователя"
                        }}}
                        {{{ Button
                                id="delete-user"
                                name="delete-user"
                                withIcon=true
                                iconSrc="/chat/plus.svg"
                                classDiv="menu-but-container"
                                iconClass="icon"
                                text="Удалить пользователя"
                                aria_label="Удалить пользователя"
                        }}}
                    </div>
                </header>
                <section class="chat-message-body">
                    {{# each selected.message}}
                        {{#if type}}
                            <div class="chat-message-body-incoming">{{text}}
                                <img src="/chat/sent.svg" alt="Доставлено">
                                <span class="chat-message-body-time">{{time}}</span>
                            </div>
                        {{else}}
                            <div class="chat-message-body-outgoing">{{text}}
                                <span class="chat-message-body-time">{{time}}</span>
                            </div>
                        {{/if}}
                    {{/each}}
                </section>
                <footer class="chat-message-footer">
                    <button type="button" aria-label="Прикрепить файл">
                        <img src="/chat/clip.svg" alt="">
                    </button>
                    <form class="flex" id="message-form">
                        {{{ Input
                                id="message"
                                name="message"
                                type="text"
                                placeholder="Сообщение"
                                aria_label="Текст сообщения"
                                className="chat-message-footer-input"
                                req=true
                                errorShow=false
                        }}}
                        {{{ Img
                                id="sendMessage"
                                src="/arrow-right-blue.svg"
                                alt="Отправить сообщение"
                                className="button-send"
                        }}}

                    </form>
                </footer>
            {{else}}
                <label>Выберите чат чтобы отправить сообщение</label>
            {{/if}}
        </section>
        {{#if modal}}
            {{{Modal
                title="Добавить пользователя"
                showCloseButton=true
                showFooterButton=true
            }}}
        {{/if}}
    </main>
</div>
