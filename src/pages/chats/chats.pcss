.chats-page{
    display: flex;
}

.chat-container{
    margin-top: 20px;
    overflow: auto;
    max-height: calc(100% - 140px);
}

.chats-list{
    border-right: 1px solid var(--border-grey);
    width: 310px;
    height: calc(100vh - 16px);
    position: relative;

    .button-profile{
        margin-left: auto;
        font-size: 12px;
        line-height: 12px;
        color: var(--color-grey);
        cursor: pointer;
        background: none;
        border: none;
    }

    .chat-item{
        display: flex;
        border-top: 1px solid var(--border-grey);
        position: relative;
        cursor: pointer;
        padding: 12px 10px;
        transition: all 0.2s ease-out;
        max-height: 73px;
        box-sizing: border-box;

        &:hover{
            background-color: var(--bg-blue);
        }

        &:last-child{
            border-bottom: 1px solid var(--border-grey);
        }

        .chat-info{
            display: flex;
            flex-direction: column;
            gap: 2px;
            margin-left: 10px;
            width: 310px;

            .last-message{
                font-size: 12px;
                line-height: 15px;
                color: var(--color-grey);
            }
        }

        .chat-avatar{
            min-width: 47px;
            max-width: 47px;
            height: 47px;
            background: var(--bg-grey);
            border-radius: 24px;
        }

        .chat-time{
            font-size: 9px;
            line-height: 13px;
            color: var(--color-grey);
            position: absolute;
            top: 12px;
            right: 10px;
        }

        .chat-count-message{
            font-size: 11px;
            line-height: 12px;
            color: var(--color-white);
            width: 20px;
            height: 20px;
            background-color: var(--color-blue);
            border-radius: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: absolute;
            top: 39px;
            right: 10px;
        }
    }

}

.chat-message{
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;

    .chat-message-header{
        height: 54px;
        border-bottom: 1px solid var(--border-grey);
        margin: 0 20px;
        display: flex;
        align-items: center;
    }

    .chat-message-body{
        font-size: 12px;
        line-height: 15px;
        color: var(--text-dark);
        display: flex;
        flex-direction: column;
        gap: 30px;
        margin-top: 20px;
        overflow-y: auto;
        max-height: calc(95vh - 105px);

        .no-message{
            position: absolute;
            top: 48%;
            left: 55%;
        }

        .chat-message-body-time{
            font-size: 9px;
            line-height: 9px;
            color: var(--color-grey);
        }

        .chat-message-body-outgoing{
            background-color: var(--bg-color);
            padding: 11px;
            margin-left: 20px;
            width: fit-content;

            .chat-message-body-time{
                color: var(--color-grey);
            }
        }

        .chat-message-body-incoming {
            background-color: var(--bg-blue);
            padding: 11px;
            margin-left: auto;
            width: fit-content;

            img{
                margin-left: 15px;
            }

            .chat-message-body-time {
                color: var(--color-blue);
            }
        }
    }

    .chat-message-footer{
        height: 54px;
        border-top: 1px solid var(--border-grey);
        position: absolute;
        bottom: 0;
        width: calc(100vw - 350px);
        margin: 0 20px;
        display: flex;
        align-items: center;

        img{
            cursor: pointer;
        }

        button{
            background: none;
            border: none;
        }

        .chat-message-footer-input{
            width: calc(100vw - 460px);
            height: 32px;
            border-radius: 30px;
            background: var(--bg-grey);
            border: none;
        }
    }

    .chat-message-avatar{
        min-width: 34px;
        max-width: 34px;
        height: 34px;
        background: var(--bg-grey);
        border-radius: 24px;
        margin-right: 10px;
    }

}

.chat-name{
    font-weight: 600;
    font-size: 13px;
    line-height: 13px;
    color: var(--text-dark);
    margin-top: 5px;
}

.chat-message-selected{
    display: block;
}

.button-cont{
    display: flex;
    margin-right: 10px;
    margin-left: auto;
    cursor: pointer;
}

.button-send{
    margin-left: 15px;
    margin-top: 2px;
}

.button-add-chat{
    width: 301px;
}

.no-chats{
    position: absolute;
    top: 10%;
    left: 30%
}

.menu{
    position: absolute;
    transition: all 0.3s ease;
    top: 70px;
    right: 25px;
    border-radius: 12px;
    box-shadow: 0 0 6px 0 #00000024;
    background-color: white;
    padding: 15px;
    box-sizing: border-box;
    gap: 5px;
    display:flex;
    flex-direction: column;
    justify-content: center;

    :nth-child(2) .icon{
        transform: rotate(45deg);
    }

    :nth-child(3) .icon{
        transform: rotate(45deg);
    }

    .icon {
        position: absolute;
        left: 15px;
    }

    .load-avatar{
        padding: 0 !important;

        img{
            padding-right: 7px;
        }

        label{
            cursor: pointer;;
        }
    }

    .button-menu {
        width: 100%;
        background-color: white;
        font-weight: 500;
        font-size: 12px;
        line-height: 14px;
        color: black;
        border: none;
        padding-left: 20px;
        display: flex;
        height: 30px;
        cursor: pointer;
        transition: all 0.3s ease;
        border-radius: 20px;
        align-items: center;

        &:hover {
            background-color: var(--bg-color-grey-hover);
        }
    }
}

.info-empty{
    font-size: 12px;
    line-height: 12px;
    color: var(--color-grey);
}

.spinner-message{
    left: 57% !important;
    top: 46% !important;
}
