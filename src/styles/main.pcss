body {
    font-family: Arial, sans-serif;
    font-weight: 500;
}

.login-page {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 95vh;
    margin: 0;
}

.login-container{
    box-shadow: 0 0 6px 0 #00000024;
    width: 340px;
    height: 450px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    flex-direction: column;
    position: relative;

    .button-container{
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
        position: absolute;
        bottom: 20px;
    }

}

.mt-30{margin-top: 30px;}

.mb-40{margin-bottom: 40px;}

.mt-50{margin-top: 50px;}

.grey-text{
    font-size: 9px;
    line-height: 9px;
    color: var(--color-grey);
}

.blue-text{
    font-size: 11px;
    line-height: 11px;
    color: var(--color-blue);
    cursor: pointer;
}

.burger-menu{
    margin-left: auto;
    margin-right: 11px;
    cursor: pointer;
}

.page-error {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    height: 100vh;

    .title{
        font-size: 40px;
        line-height: 40px;
        margin-bottom: 20px;
    }

    .text{
        font-size: 20px;
        line-height: 20px;
        margin-bottom: 70px;
    }

    button{
        background: none;
        border: none;
        font-size: 11px;
        line-height: 11px;
        color: var(--color-blue);
        cursor: pointer;
    }

}

.form-group{
    max-width: 510px;
    width: 100%;
    border-bottom: 1px solid var(--border-grey);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;

    button{
        background-color: white;
        border: none;
    }

    .left-element{
        font-size: 13px;
        line-height: 13px;
    }

    .right-element{
        font-size: 13px;
        line-height: 13px;
        color: var(--color-grey);
    }
}

.color-blue{
    color: var(--color-blue);
    cursor: pointer;
}

.color-red{
    color: var(--color-red);
    cursor: pointer;
}

.input-container{
    margin: 0 30px;
    gap: 10px;

    input{
        height: 27px;
        border-color: var(--color-blue);
        width: 280px;
        border-left: none;
        border-right: none;
        border-top: none;
        &:focus{outline: none;}
    }
}

.flex-column{
    display: flex;
    flex-direction: column;
}

.flex{
    display: flex;
}

.button{
    width: 280px;
    height: 37px;
    border-radius: 8px;
    opacity: 1;
    background-color: var(--color-blue);
    border: none;
    font-size: 13px;
    line-height: 13px;
    color: var(--color-white);
    cursor: pointer;
}

input{
    padding-left: 10px;

    &::placeholder {
        font-size: 12px;
        line-height: 12px;
        color: var(--color-grey);
    }

    &:focus{
        outline: none;
    }
}

h1, h2{
    font-weight: 500;
}
